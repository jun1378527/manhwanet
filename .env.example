# 이 파일을 복사해 .env 를 만들고 값을 채운다:  cp .env.example .env
# .env 는 Git에 커밋되지 않는다. 실제 비밀번호를 이 파일(.env.example)에 적지 않는다.
# 값에 따옴표를 쓰지 않는다. (Backend가 .properties 형식으로 읽는다)

# PostgreSQL (docker-compose.yml, Backend 공용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manhwanet
TEST_DB_NAME=manhwanet_test
DB_USERNAME=manhwanet
DB_PASSWORD=

# Backend
SERVER_PORT=8080
